# Copy this file to .env and fill in the keys you have. .env is git-ignored.
# Providers without a key are skipped; the fallback order is set by --providers.

# Google Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Ollama runs locally and needs no key. Only set this if it is not on the default address.
# OLLAMA_HOST=http://localhost:11434
